# SmartShop AI Customer Service Chatbot Environment Configuration
# Copy this file to .env and configure your values

# Groq API Key (Get a free API key at https://console.groq.com)
# If left empty, the chatbot automatically operates in robust Rule-Based Fallback Mode
GROQ_API_KEY=

# Groq LLM Model (Options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
GROQ_MODEL=llama-3.3-70b-versatile

# Flask Server Configuration
PORT=5000
DEBUG=True
SECRET_KEY=change-me-before-deploying
